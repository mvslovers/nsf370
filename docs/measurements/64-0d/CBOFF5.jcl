//CBOFF5   JOB (A),'CB OFFSETS 5',CLASS=A,MSGCLASS=H,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*
//* 64-0d: the SRM per-address-space state.  ASCBOUCB was computed in
//* CBOFF4 (X'90'); this job adds ASCBOUXB, the whole OUCB swap-state
//* set, and re-emits the ASCB flag bits as COMPUTED constants so the
//* values are not merely read out of the macro source.
//*
//ASM     EXEC PGM=IFOX00,PARM='NODECK,NOLOAD,NORLD,NOXREF',REGION=4M
//SYSLIB   DD DSN=SYS1.AMODGEN,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(900,200))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSIN    DD *
CBOFF5   CSECT
AOUXB    DC    AL2(ASCBOUXB-ASCB)
AOUCB    DC    AL2(ASCBOUCB-ASCB)
ADSP1    DC    AL2(ASCBDSP1-ASCB)
ARCTF    DC    AL2(ASCBRCTF-ASCB)
AFLG1    DC    AL2(ASCBFLG1-ASCB)
BNOQ     DC    X'00',AL1(ASCBNOQ)
BFAIL    DC    X'00',AL1(ASCBFAIL)
BTMNO    DC    X'00',AL1(ASCBTMNO)
BFRS     DC    X'00',AL1(ASCBFRS)
BFQU     DC    X'00',AL1(ASCBFQU)
BWAIT    DC    X'00',AL1(ASCBWAIT)
BOUT     DC    X'00',AL1(ASCBOUT)
BTMLW    DC    X'00',AL1(ASCBTMLW)
BSTND    DC    X'00',AL1(ASCBSTND)
BNSWP    DC    X'00',AL1(ASCBNSWP)
UFWD     DC    AL2(OUCBFWD-OUCB)
UBCK     DC    AL2(OUCBBCK-OUCB)
UQFL     DC    AL2(OUCBQFL-OUCB)
USFL     DC    AL2(OUCBSFL-OUCB)
UYFL     DC    AL2(OUCBYFL-OUCB)
UAFL     DC    AL2(OUCBAFL-OUCB)
UTFL     DC    AL2(OUCBTFL-OUCB)
UEFL     DC    AL2(OUCBEFL-OUCB)
UUFL     DC    AL2(OUCBUFL-OUCB)
UNDS     DC    AL2(OUCBNDS-OUCB)
USRC     DC    AL2(OUCBSRC-OUCB)
USWC     DC    AL2(OUCBSWC-OUCB)
UASCB    DC    AL2(OUCBASCB-OUCB)
UACT     DC    AL2(OUCBACT-OUCB)
UACN     DC    AL2(OUCBACN-OUCB)
UCFL     DC    AL2(OUCBCFL-OUCB)
UDMN     DC    AL2(OUCBDMN-OUCB)
ULEN     DC    AL2(OUCBLEN)
UGOO     DC    X'00',AL1(OUCBGOO)
UGOI     DC    X'00',AL1(OUCBGOI)
UGOB     DC    X'00',AL1(OUCBGOB)
UOFF     DC    X'00',AL1(OUCBOFF)
UOUT     DC    X'00',AL1(OUCBOUT)
UNSW     DC    X'00',AL1(OUCBNSW)
UINV     DC    X'00',AL1(OUCBINV)
UNSWI    DC    X'00',AL1(OUCBNSWI)
ULWT     DC    X'00',AL1(OUCBLWT)
UMWT     DC    X'00',AL1(OUCBMWT)
URSWP    DC    X'00',AL1(OUCBRSWP)
UTSWP    DC    X'00',AL1(OUCBTSWP)
UTSWC    DC    X'00',AL1(OUCBTSWC)
URDY     DC    X'00',AL1(OUCBRDY)
URSM     DC    X'00',AL1(OUCBRSM)
XRSW     DC    AL2(OUXBRSW-OUXB)
         IHAASCB
         IRAOUCB
         IHAOUXB
         END
/*
